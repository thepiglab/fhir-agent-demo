# Cache rules for Cloudflare Pages and Netlify (both read this file from the site root).
# Vite fingerprints everything under /assets/, so it can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The exported data and the pages can change between deploys: revalidate after five minutes.
/data/*
  Cache-Control: public, max-age=300
/*.html
  Cache-Control: public, max-age=300
/
  Cache-Control: public, max-age=300

# No cross-origin-isolation headers on purpose: the WebGPU runtime uses no SharedArrayBuffer,
# Atomics or Worker, so COOP/COEP (and a coi-serviceworker) would only break loading the model
# from Hugging Face.
