{
  "name": "lfm3-fhir-demo",
  "version": "0.1.0",
  "private": true,
  "description": "An LFM3 1.7B FHIR search agent running in the browser on WebGPU, with the Chart assistant and a benchmark checker",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p tests",
    "bench": "node scripts/bench_chrome.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@webgpu/types": "^0.1.74",
    "ajv": "^8.20.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "use-stick-to-bottom": "1.1.6"
  }
}
